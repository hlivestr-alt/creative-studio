{
  "name": "proya-creative-studio",
  "version": "1.0.0",
  "description": "Local creative planning studio for the PROYA 5X Vitamin C series",
  "author": "PROYA Internal Creative Team",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:icons": "electron scripts/render-icons.cjs",
    "build:app": "npm run build:icons && vite build && tsup",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "build:local-runner": "tsup --config tsup.local-runner.config.ts",
    "build": "npm run build:portable",
    "dist": "npm run build:portable",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "validate": "npm run lint && npm test",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "sql.js": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@vitejs/plugin-react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sql.js": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "tsup": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "afterPack": "scripts/verify-h3-package.cjs",
    "compression": "store",
    "electronDist": "node_modules/electron/dist",
    "appId": "com.proya.creativestudio",
    "productName": "PROYA Creative Studio",
    "directories": { "output": ".portable-build" },
    "files": ["dist/**/*", "dist-electron/**/*", "data/**/*", "prompts/**/*", "package.json"],
    "extraResources": [
      { "from": "product-assets", "to": "product-assets" },
      { "from": "references", "to": "references" },
      { "from": "workflows/minimax-h3-api.json", "to": "workflows/minimax-h3-api.json" },
      { "from": "prompts/minimax-h3-lmstudio-system.md", "to": "prompts/minimax-h3-lmstudio-system.md" },
      { "from": "assets/app-icon.ico", "to": "app-icon.ico" }
    ],
    "extraMetadata": { "main": "dist-electron/main.cjs" },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "PROYA-Creative-Studio.portable.${ext}"
    }
  }
}
