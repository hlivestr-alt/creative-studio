+def _native_model_entry(payload: dict) -> dict | None:
+    models = payload.get("models") if isinstance(payload, dict) else []
+    if not isinstance(models, list):
+        return None
+    for item in models:
+        if not isinstance(item, dict):
+            continue
+        key = str(item.get("key", item.get("id", ""))).strip()
+        if key == PROMPT_ENGINE_MODEL_ID:
+            return item
+    return None
+
+
+def _native_model_observation(root: str, api_key: str, timeout: int) -> tuple[str, str | None]:
+    payload = _request_json(_native_root(root) + "/api/v1/models", None, api_key, timeout)
+    target = _native_model_entry(payload)
+    if target is None:
+        raise ValueError(f"{PROMPT_ENGINE_MODEL_ID} is not available in LM Studio on the remote PC.")
+    instances = target.get("loaded_instances") or []
+    instance_ids = [
+        str(instance.get("id", instance.get("instance_id", ""))).strip()
+        for instance in instances
+        if isinstance(instance, dict) and str(instance.get("id", instance.get("instance_id", ""))).strip()
+    ]
+    # A native chat response identifies the exact instance after JIT/autoload;
+    # preflight never guesses when more than one target instance is present.
+    return PROMPT_ENGINE_MODEL_ID, instance_ids[0] if len(instance_ids) == 1 else None
+
