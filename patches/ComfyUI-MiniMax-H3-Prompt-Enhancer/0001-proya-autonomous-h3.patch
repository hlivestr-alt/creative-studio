+
+    exact_instance_id = "qwen-instance-used-for-rewrite"
+    unrelated_instance_id = "unrelated-loaded-instance"
+    observations = iter([
+        {
+            "models": [
+                {"key": "unrelated/model", "loaded_instances": [{"id": unrelated_instance_id}]},
+                {"key": PROMPT_ENGINE_MODEL_ID, "loaded_instances": [{"id": exact_instance_id}]},
+            ]
+        },
+        {
+            "models": [
+                {"key": "unrelated/model", "loaded_instances": [{"id": unrelated_instance_id}]},
+                {"key": PROMPT_ENGINE_MODEL_ID, "loaded_instances": []},
+            ]
+        },
+    ])
+    unload_requests = []
+
+    def fake_json_request(url, method="GET", body=None):
+        if method == "POST":
