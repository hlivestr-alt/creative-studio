+class MiniMaxH3UnloadLMStudioModel:
+    """Unload only the exact model instance emitted by the prompt enhancer."""
+
+    CATEGORY = "MiniMax H3/Prompting"
+    FUNCTION = "unload"
+    RETURN_TYPES = ("STRING", "BOOLEAN", "STRING", "BOOLEAN", "STRING", "STRING", "INT")
+    RETURN_NAMES = ("prompt", "valid", "validation_report", "unload_succeeded", "unload_error", "instance_id", "unload_duration_ms")
+    DESCRIPTION = "Call LM Studio's native unload endpoint for the exact prompt-model instance and verify it is gone."
+
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {"required": {
+            "prompt": ("STRING", {"multiline": True, "default": "", "dynamicPrompts": False}),
+            "valid": ("BOOLEAN", {"default": False}),
+            "validation_report": ("STRING", {"multiline": True, "default": "", "dynamicPrompts": False}),
+            "endpoint": ("STRING", {"default": "http://127.0.0.1:1234/v1"}),
+            "model": ("STRING", {"default": PROMPT_ENGINE_MODEL_ID, "tooltip": "Fixed autonomous prompt model; the value emitted by MiniMaxH3PromptEnhancer is used."}),
+            "instance_id": ("STRING", {"default": "", "tooltip": "Exact loaded instance ID emitted by MiniMaxH3PromptEnhancer."}),
+            "unload": ("BOOLEAN", {"default": True}),
+        }}
+
+    @staticmethod
+    def _root(endpoint):
+        root = str(endpoint or "").rstrip("/")
+        return root[:-3] if root.lower().endswith("/v1") else root
+
+    @classmethod
+    def _json_request(cls, url, method="GET", body=None):
+        data = None if body is None else json.dumps(body).encode("utf-8")
+        request = urllib.request.Request(
+            url,
+            data=data,
+            method=method,
+            headers={"Accept": "application/json", **({"Content-Type": "application/json"} if data else {})},
+        )
+        with urllib.request.urlopen(request, timeout=20) as response:
+            raw = response.read().decode("utf-8")
+        return json.loads(raw) if raw.strip() else {}
+
+    @staticmethod
+    def _result(prompt, valid, validation_report, succeeded, error, instance_id, started_at):
+        duration_ms = max(0, int(round((time.monotonic() - started_at) * 1000)))
+        normalized_error = str(error).strip() if error else ""
+        normalized_instance_id = str(instance_id).strip() if instance_id else ""
+        result = (str(prompt), bool(valid), str(validation_report or ""), bool(succeeded), normalized_error, normalized_instance_id, duration_ms)
+        structured_output = {
+            "schemaVersion": 1,
+            "instance_id": normalized_instance_id or None,
+            "llm_instance_id": normalized_instance_id or None,
+            "unload_succeeded": bool(succeeded),
+            "unload_error": normalized_error or None,
+            "unload_duration_ms": duration_ms,
+        }
+        return {
+            "ui": {
+                "proya_h3_structured_output": [json.dumps(structured_output, ensure_ascii=False, separators=(",", ":"))],
+            },
+            "result": result,
+        }
+
+    def unload(self, prompt, valid, validation_report, endpoint, model, instance_id, unload):
+        started_at = time.monotonic()
+        target_instance_id = str(instance_id or "").strip()
+        resolved_instance_id = target_instance_id
+        try:
+            if not bool(valid):
+                raise ValueError("MiniMax H3 prompt validation failed; LM Studio unload was not attempted.")
+            if not bool(unload):
+                return self._result(prompt, True, validation_report, False, "Unload disabled by settings.", instance_id, started_at)
+            # Ignore legacy widget values; only the canonical prompt model is eligible.
+            selected_model = PROMPT_ENGINE_MODEL_ID
+            if not target_instance_id:
+                raise ValueError("LM Studio unload requires the exact instance ID emitted by the prompt enhancer.")
+            root = self._root(endpoint)
+            models = self._json_request(root + "/api/v1/models")
+            selected = next(
+                (
+                    item for item in models.get("models", [])
+                    if isinstance(item, dict)
+                    and str(item.get("key", item.get("model_key", ""))) == selected_model
+                ),
+                None,
+            )
+            if selected is None:
+                raise ValueError("LM Studio no longer reports the exact prompt model; refusing to unload another model.")
+            instances = selected.get("loaded_instances", [])
+            matching_instances = [
+                str(item.get("id", item.get("instance_id", ""))).strip()
+                for item in instances
+                if isinstance(item, dict) and str(item.get("id", item.get("instance_id", ""))).strip()
+            ]
+            if matching_instances != [target_instance_id]:
+                raise ValueError("LM Studio no longer reports exactly the prompt-model instance emitted by node 149.")
+            resolved_instance_id = target_instance_id
+            response = self._json_request(root + "/api/v1/models/unload", "POST", {"instance_id": target_instance_id})
+            if str(response.get("instance_id", target_instance_id)) != target_instance_id:
+                raise ValueError("LM Studio returned an unexpected unload instance ID.")
+            remaining = self._json_request(root + "/api/v1/models")
+            still_loaded = any(
+                isinstance(item, dict)
+                and str(item.get("key", item.get("model_key", ""))) == selected_model
+                and any(
+                    isinstance(candidate, dict)
+                    and str(candidate.get("id", candidate.get("instance_id", ""))) == target_instance_id
+                    for candidate in item.get("loaded_instances", [])
+                )
+                for item in remaining.get("models", [])
+            )
+            if still_loaded:
+                raise ValueError("LM Studio still reports the exact prompt-model instance after unload.")
+            return self._result(prompt, True, validation_report, True, "", resolved_instance_id, started_at)
+        except Exception as exc:
+            raise RuntimeError(f"LM Studio exact-instance unload failed for {resolved_instance_id or 'unknown'}: {exc}") from exc
