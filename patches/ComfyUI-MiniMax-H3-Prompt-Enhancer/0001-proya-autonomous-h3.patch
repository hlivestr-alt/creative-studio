+            raise
+        models = available_models(root, str(api_key or ""), max(3, min(int(timeout), 60)))
+        if PROMPT_ENGINE_MODEL_ID in models:
+            return PROMPT_ENGINE_MODEL_ID, None
+        raise ValueError(f"{PROMPT_ENGINE_MODEL_ID} is not available in LM Studio on the remote PC.")
